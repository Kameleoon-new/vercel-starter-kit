# Kameleoon project site code (Kameleoon platform -> project dashboard)
KAMELEOON_SITE_CODE=
# Kameleoon client API credentials (Kameleoon platform -> profile -> API credentials)
KAMELEOON_CLIENT_ID=
KAMELEOON_CLIENT_SECRET=

# Vercel Global Config connection string, created when you connect a Global
# Config store with the Kameleoon integration to the project. Used when
# DATAFILE_SOURCE is DatafileSource.GlobalConfig in lib/constants.ts (the
# default); with DatafileSource.Kameleoon the SDK fetches the configuration
# from the Kameleoon CDN instead.
GLOBAL_CONFIG=
